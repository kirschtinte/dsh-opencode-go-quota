# Nothing here is installed: the plugin ships no dependencies and the profile
# links this directory rather than copying it.
node_modules/

# Harness runtime state, if anyone ever runs the app with this as its cwd.
.dsh/

# macOS
.DS_Store

# Editor and shell scratch
.vscode/
.idea/
*.swp

# Never commit a key that a command happened to generate in this directory.
# `ssh-keygen` writes to the working directory when given a bare filename.
id_ed25519*
id_rsa*
id_ecdsa*
*.pem
gitkey*
